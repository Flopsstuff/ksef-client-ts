  "components": {
    "schemas": {
      "AllowedIps": {
        "type": "object",
        "properties": {
          "ip4Addresses": {
            "type": "array",
            "items": {
              "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$",
              "type": "string"
            },
            "nullable": true
          },
          "ip4Ranges": {
            "type": "array",
            "items": {
              "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}-((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$",
              "type": "string"
            },
            "nullable": true
          },
          "ip4Masks": {
            "type": "array",
            "items": {
              "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}\\/(0|[1-9]|1[0-9]|2[0-9]|3[0-2])$",
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "AuthenticationChallengeResponse": {
        "required": [
          "challenge",
          "clientIp",
          "timestamp",
          "timestampMs"
        ],
        "type": "object",
        "properties": {
          "challenge": {
            "$ref": "#/components/schemas/Challenge"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "timestampMs": {
            "type": "integer",
            "format": "int64"
          },
          "clientIp": {
            "type": "string"
          }
        }
      },
      "AuthenticationContextIdentifier": {
        "required": [
          "type",
          "value"
        ],
        "type": "object",
        "properties": {
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthenticationContextIdentifierType"
              }
            ]
          },
          "value": {
            "type": "string"
          }
        }
      },
      "AuthenticationContextIdentifierType": {
        "enum": [
          "Nip",
          "InternalId",
          "NipVatUe",
          "PeppolId"
        ],
        "type": "string"
      },
      "AuthenticationInitResponse": {
        "required": [
          "authenticationToken",
          "referenceNumber"
        ],
        "type": "object",
        "properties": {
          "referenceNumber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReferenceNumber"
              }
            ]
          },
          "authenticationToken": {
            "required": [
              "token",
              "validUntil"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/TokenInfo"
              }
            ]
          }
        }
      },
      "AuthenticationMethod": {
        "enum": [
          "Token",
          "TrustedProfile",
          "InternalCertificate",
          "QualifiedSignature",
          "QualifiedSeal",
          "PersonalSignature",
          "PeppolSignature"
        ],
        "type": "string"
      },
      "AuthenticationMethodCategory": {
        "enum": [
          "XadesSignature",
          "NationalNode",
          "Token",
          "Other"
        ],
        "type": "string"
      },
      "AuthenticationMethodInfo": {
        "required": [
          "category",
          "code",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthenticationMethodCategory"
              }
            ]
          },
          "code": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "AuthenticationOperationStatusResponse": {
        "required": [
          "authenticationMethod",
          "authenticationMethodInfo",
          "startDate",
          "status"
        ],
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "authenticationMethod": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthenticationMethod"
              }
            ],
            "deprecated": true,
            "x-removal-date": "2026-11-16"
          },
          "authenticationMethodInfo": {
            "required": [
              "category",
              "code",
              "displayName"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthenticationMethodInfo"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StatusInfo"
              }
            ]
          },
          "isTokenRedeemed": {
            "type": "boolean",
            "nullable": true
          },
          "lastTokenRefreshDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "refreshTokenValidUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "AuthenticationTokenRefreshResponse": {
        "required": [
          "accessToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "required": [
              "token",
              "validUntil"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/TokenInfo"
              }
            ]
          }
        }
      },
      "AuthenticationTokensResponse": {
        "required": [
          "accessToken",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "required": [
              "token",
              "validUntil"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/TokenInfo"
              }
            ]
          },
          "refreshToken": {
            "required": [
              "token",
              "validUntil"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/TokenInfo"
              }
            ]
          }
        }
      },
      "AuthorizationPolicy": {
        "type": "object",
        "properties": {
          "allowedIps": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AllowedIps"
              }
            ],
            "nullable": true
          }
        }
      },
      "Challenge": {
        "maxLength": 36,
        "minLength": 36,
        "type": "string"
      },
      "ExceptionDetails": {
        "type": "object",
        "properties": {
          "exceptionCode": {
            "type": "integer",
            "format": "int32"
          },
          "exceptionDescription": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "ExceptionInfo": {
        "type": "object",
        "properties": {
          "exceptionDetailList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExceptionDetails"
            },
            "nullable": true
          },
          "referenceNumber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReferenceNumber"
              }
            ],
            "nullable": true
          },
          "serviceCode": {
            "type": "string",
            "nullable": true
          },
          "serviceCtx": {
            "type": "string",
            "nullable": true
          },
          "serviceName": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExceptionResponse": {
        "type": "object",
        "properties": {
          "exception": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExceptionInfo"
              }
            ],
            "nullable": true
          }
