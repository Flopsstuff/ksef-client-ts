                  "$ref": "#/components/schemas/TooManyRequestsResponse"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequestsProblemDetails"
                }
              }
            },
            "x-summary": "Too Many Requests"
          }
        },
        "x-rate-limits": {
          "perSecond": 60
        }
      }
    }
  },
