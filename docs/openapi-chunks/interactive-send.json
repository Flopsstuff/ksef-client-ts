{
  "openapi": "3.0.4",
  "info": {
    "title": "KSeF API TE",
    "version": "v2"
  },
  "paths": {
    "/sessions/online": {
      "post": {
        "tags": [
          "Wysyłka interaktywna"
        ],
        "summary": "Otwarcie sesji interaktywnej",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "formCode",
                  "encryption"
                ],
                "allOf": [
                  {
                    "$ref": "#/components/schemas/OpenOnlineSessionRequest"
                  }
                ]
              },
              "example": {
                "formCode": {
                  "systemCode": "FA (3)",
                  "schemaVersion": "1-0E",
                  "value": "FA"
                },
                "encryption": {
                  "encryptedSymmetricKey": "",
                  "initializationVector": "OmtDQdl6vkOI1GLKZSjgEg=="
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenOnlineSessionResponse"
                },
                "example": {
                  "referenceNumber": "20250625-SO-2C3E6C8000-B675CF5D68-07",
                  "validUntil": "2025-07-11T12:23:56.0154302+00:00"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            },
            "x-summary": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedProblemDetails"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenProblemDetails"
                }
              }
            }
          },
          "429": {
            "headers": {
              "Retry-After": {
                "schema": {
                  "$ref": "#/components/schemas/RetryAfter"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequestsResponse"
                }
              }
            },
            "x-summary": "Too Many Requests"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "x-rate-limits": {
          "perSecond": 100,
          "perMinute": 300,
          "perHour": 1200
        },
        "x-required-permissions": [
          "InvoiceWrite",
          "PefInvoiceWrite",
          "EnforcementOperations"
        ]
      }
    },
    "/sessions/online/{referenceNumber}/invoices": {
      "post": {
        "tags": [
          "Wysyłka interaktywna"
        ],
        "summary": "Wysłanie faktury",
        "parameters": [
          {
            "name": "referenceNumber",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ReferenceNumber"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "invoiceHash",
                  "invoiceSize",
                  "encryptedInvoiceHash",
                  "encryptedInvoiceSize",
                  "encryptedInvoiceContent"
                ],
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SendInvoiceRequest"
                  }
                ]
              },
              "example": {
                "invoiceHash": "EbrK4cOSjW4hEpJaHU71YXSOZZmqP5++dK9nLgTzgV4=",
                "invoiceSize": 6480,
                "encryptedInvoiceHash": "miYb1z3Ljw5VucTZslv3Tlt+V/EK1V8Q8evD8HMQ0dc=",
                "encryptedInvoiceSize": 6496,
                "encryptedInvoiceContent": "...",
                "offlineMode": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendInvoiceResponse"
                },
                "example": {
                  "referenceNumber": "20250625-EE-319D7EE000-B67F415CDC-2C"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            },
            "x-summary": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedProblemDetails"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenProblemDetails"
                }
              }
            }
          },
          "429": {
            "headers": {
              "Retry-After": {
                "schema": {
                  "$ref": "#/components/schemas/RetryAfter"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequestsResponse"
                }
              }
            },
            "x-summary": "Too Many Requests"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "x-rate-limits": {
          "perSecond": 100,
          "perMinute": 300,
          "perHour": 1800
        },
        "x-required-permissions": [
          "InvoiceWrite",
          "PefInvoiceWrite",
          "EnforcementOperations"
        ]
      }
    },
    "/sessions/online/{referenceNumber}/close": {
      "post": {
        "tags": [
          "Wysyłka interaktywna"
        ],
        "summary": "Zamknięcie sesji interaktywnej",
        "parameters": [
          {
            "name": "referenceNumber",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ReferenceNumber"
            }
          }
        ],
        "responses": {
          "204": {},
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionResponse"
                }
              }
            },
            "x-summary": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedProblemDetails"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenProblemDetails"
                }
              }
            }
          },
          "429": {
            "headers": {
              "Retry-After": {
                "schema": {
                  "$ref": "#/components/schemas/RetryAfter"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequestsResponse"
                }
              }
            },
            "x-summary": "Too Many Requests"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "x-rate-limits": {
          "perSecond": 100,
          "perMinute": 300,
          "perHour": 1200
        },
        "x-required-permissions": [
          "InvoiceWrite",
          "PefInvoiceWrite",
          "EnforcementOperations"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EncryptionInfo": {
        "required": [
          "encryptedSymmetricKey",
          "initializationVector"
        ],
        "type": "object",
        "properties": {
          "encryptedSymmetricKey": {
            "type": "string",
            "format": "byte"
          },
          "initializationVector": {
            "type": "string",
            "format": "byte"
          }
        }
      },
      "ExceptionDetails": {
        "type": "object",
        "properties": {
          "exceptionCode": {
            "type": "integer",
            "format": "int32"
          },
          "exceptionDescription": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "ExceptionInfo": {
        "type": "object",
        "properties": {
          "exceptionDetailList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExceptionDetails"
            },
            "nullable": true
          },
          "referenceNumber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReferenceNumber"
              }
            ],
            "nullable": true
          },
          "serviceCode": {
            "type": "string",
            "nullable": true
          },
          "serviceCtx": {
            "type": "string",
            "nullable": true
          },
          "serviceName": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExceptionResponse": {
        "type": "object",
        "properties": {
          "exception": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExceptionInfo"
              }
            ],
            "nullable": true
          }
        },
        "example": {
          "exception": {
            "exceptionDetailList": [
              {
                "exceptionCode": 12345,
                "exceptionDescription": "Opis błędu.",
                "details": [
                  "Opcjonalne dodatkowe szczegóły błędu."
                ]
              }
            ],
            "referenceNumber": "a1b2c3d4-e5f6-4789-ab12-cd34ef567890",
            "serviceCode": "00-c02cc3747020c605be02159bf3324f0e-eee7647dc67aa74a-00",
            "serviceCtx": "srvABCDA",
            "serviceName": "Undefined",
            "timestamp": "2025-10-11T12:23:56.0154302"
          }
        }
      },
      "ForbiddenProblemDetails": {
        "required": [
          "detail",
          "reasonCode",
          "status",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "reasonCode": {
            "type": "string"
          },
          "security": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            },
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          }
        },
        "example": {
          "title": "Forbidden",
          "status": 403,
          "detail": "Brak wymaganych uprawnień do wykonania operacji w bieżącym kontekście.",
          "reasonCode": "missing-permissions",
          "security": {
            "requiredAnyOfPermissions": [
              "InvoiceRead",
              "InvoiceWrite"
            ],
            "presentPermissions": [
              "CredentialsManage"
            ]
          }
        }
      },
      "FormCode": {
        "required": [
          "schemaVersion",
          "systemCode",
          "value"
        ],
        "type": "object",
        "properties": {
          "systemCode": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "OpenOnlineSessionRequest": {
        "required": [
          "encryption",
          "formCode"
        ],
        "type": "object",
        "properties": {
          "formCode": {
            "required": [
              "systemCode",
              "schemaVersion",
              "value"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/FormCode"
              }
            ]
          },
          "encryption": {
            "required": [
              "encryptedSymmetricKey",
              "initializationVector"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/EncryptionInfo"
              }
            ]
          }
        }
      },
      "OpenOnlineSessionResponse": {
        "required": [
          "referenceNumber",
          "validUntil"
        ],
        "type": "object",
        "properties": {
          "referenceNumber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReferenceNumber"
              }
            ]
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReferenceNumber": {
        "maxLength": 36,
        "minLength": 36,
        "type": "string"
      },
      "RetryAfter": {
        "type": "integer",
        "format": "int32",
        "example": 30
      },
      "SendInvoiceRequest": {
        "required": [
          "encryptedInvoiceContent",
          "encryptedInvoiceHash",
          "encryptedInvoiceSize",
          "invoiceHash",
          "invoiceSize"
        ],
        "type": "object",
        "properties": {
          "invoiceHash": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Sha256HashBase64"
              }
            ]
          },
          "invoiceSize": {
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "encryptedInvoiceHash": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Sha256HashBase64"
              }
            ]
          },
          "encryptedInvoiceSize": {
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "encryptedInvoiceContent": {
            "type": "string",
            "format": "byte"
          },
          "offlineMode": {
            "type": "boolean",
            "default": false
          },
          "hashOfCorrectedInvoice": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Sha256HashBase64"
              }
            ],
            "nullable": true
          }
        }
      },
      "SendInvoiceResponse": {
        "required": [
          "referenceNumber"
        ],
        "type": "object",
        "properties": {
          "referenceNumber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReferenceNumber"
              }
            ]
          }
        }
      },
      "Sha256HashBase64": {
        "maxLength": 44,
        "minLength": 44,
        "type": "string",
        "format": "byte"
      },
      "TooManyRequestsResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "required": [
              "code",
              "description",
              "details"
            ],
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "example": {
          "status": {
            "code": 429,
            "details": [
              "Przekroczono limit 20 żądań na minutę. Spróbuj ponownie po 30 sekundach."
            ]
          }
        }
      },
      "UnauthorizedProblemDetails": {
        "required": [
          "detail",
          "status",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          }
        },
        "example": {
          "title": "Unauthorized",
          "status": 401,
          "detail": "Wymagane jest uwierzytelnienie."
        }
      }
    }
  }
}