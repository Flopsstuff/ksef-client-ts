              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TooManyRequestsResponse"
                }
              }
            },
            "x-summary": "Too Many Requests"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "x-rate-limits": {
          "perSecond": 100,
          "perMinute": 300,
          "perHour": 1200
        },
        "x-sort": [
          {
            "field": "startDate",
            "direction": "Desc"
          }
        ]
      }
    },
