  "components": {
    "schemas": {
      "AuthenticationListItem": {
        "required": [
          "authenticationMethod",
          "authenticationMethodInfo",
          "referenceNumber",
          "startDate",
          "status"
        ],
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "authenticationMethod": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthenticationMethod"
              }
            ],
            "deprecated": true,
            "x-removal-date": "2026-11-16"
          },
          "authenticationMethodInfo": {
            "required": [
              "category",
              "code",
              "displayName"
            ],
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthenticationMethodInfo"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StatusInfo"
              }
            ]
          },
          "isTokenRedeemed": {
            "type": "boolean",
            "nullable": true
          },
          "lastTokenRefreshDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "refreshTokenValidUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "referenceNumber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReferenceNumber"
              }
            ]
          },
          "isCurrent": {
            "type": "boolean",
            "readOnly": true
          }
        }
      },
      "AuthenticationListResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "continuationToken": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthenticationListItem"
            }
          }
        }
      },
      "AuthenticationMethod": {
        "enum": [
          "Token",
          "TrustedProfile",
          "InternalCertificate",
          "QualifiedSignature",
          "QualifiedSeal",
          "PersonalSignature",
          "PeppolSignature"
        ],
        "type": "string"
      },
      "AuthenticationMethodCategory": {
        "enum": [
          "XadesSignature",
          "NationalNode",
          "Token",
          "Other"
        ],
        "type": "string"
      },
      "AuthenticationMethodInfo": {
        "required": [
          "category",
          "code",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuthenticationMethodCategory"
              }
            ]
          },
          "code": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "ExceptionDetails": {
        "type": "object",
        "properties": {
          "exceptionCode": {
            "type": "integer",
            "format": "int32"
          },
          "exceptionDescription": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "ExceptionInfo": {
        "type": "object",
        "properties": {
          "exceptionDetailList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExceptionDetails"
            },
            "nullable": true
          },
          "referenceNumber": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ReferenceNumber"
              }
            ],
            "nullable": true
          },
          "serviceCode": {
            "type": "string",
            "nullable": true
          },
          "serviceCtx": {
            "type": "string",
            "nullable": true
          },
          "serviceName": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExceptionResponse": {
        "type": "object",
        "properties": {
          "exception": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ExceptionInfo"
              }
            ],
            "nullable": true
          }
        },
        "example": {
          "exception": {
            "exceptionDetailList": [
              {
                "exceptionCode": 12345,
                "exceptionDescription": "Opis błędu.",
                "details": [
                  "Opcjonalne dodatkowe szczegóły błędu."
                ]
              }
            ],
            "referenceNumber": "a1b2c3d4-e5f6-4789-ab12-cd34ef567890",
            "serviceCode": "00-c02cc3747020c605be02159bf3324f0e-eee7647dc67aa74a-00",
            "serviceCtx": "srvABCDA",
            "serviceName": "Undefined",
            "timestamp": "2025-10-11T12:23:56.0154302"
          }
        }
      },
      "ForbiddenProblemDetails": {
        "required": [
          "detail",
          "reasonCode",
          "status",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "reasonCode": {
            "type": "string"
          },
          "security": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            },
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          }
        },
        "example": {
          "title": "Forbidden",
          "status": 403,
          "detail": "Brak wymaganych uprawnień do wykonania operacji w bieżącym kontekście.",
          "reasonCode": "missing-permissions",
          "security": {
            "requiredAnyOfPermissions": [
              "InvoiceRead",
              "InvoiceWrite"
            ],
            "presentPermissions": [
              "CredentialsManage"
            ]
          }
        }
      },
      "ReferenceNumber": {
        "maxLength": 36,
        "minLength": 36,
        "type": "string"
      },
      "RetryAfter": {
        "type": "integer",
        "format": "int32",
        "example": 30
      },
      "StatusInfo": {
        "required": [
          "code",
          "description"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "TooManyRequestsResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "required": [
              "code",
              "description",
              "details"
            ],
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "example": {
          "status": {
            "code": 429,
            "details": [
              "Przekroczono limit 20 żądań na minutę. Spróbuj ponownie po 30 sekundach."
            ]
          }
        }
      },
      "UnauthorizedProblemDetails": {
        "required": [
          "detail",
          "status",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          }
        },
        "example": {
          "title": "Unauthorized",
          "status": 401,
          "detail": "Wymagane jest uwierzytelnienie."
        }
      }
    }
  }
}