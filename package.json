{
  "name": "ksef-client-ts",
  "version": "0.4.0",
  "description": "TypeScript client for the Polish National e-Invoice System (KSeF) API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "ksef": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e --reporter=verbose",
    "test:e2e:watch": "vitest tests/e2e --reporter=verbose",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "link": "npm link",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check-api": "node scripts/check-openapi-coverage.mjs",
    "split-openapi": "node scripts/split-openapi.mjs",
    "sync-schemas": "node scripts/sync-xsd-schemas.mjs"
  },
  "keywords": [
    "ksef",
    "e-invoice",
    "e-faktura",
    "invoice",
    "faktura",
    "fa3",
    "xml",
    "poland",
    "tax",
    "typescript",
    "node",
    "sdk",
    "cli"
  ],
  "author": "Flop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flopsstuff/ksef-client-ts.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@peculiar/x509": "^1.12.3",
    "citty": "^0.2.1",
    "cli-table3": "^0.6.5",
    "consola": "^3.4.2",
    "fast-xml-parser": "^5.2.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.0.0",
    "yauzl": "^3.2.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@scalar/api-reference": "^1.49.3",
    "@types/node": "^22.13.10",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3",
    "@vitest/coverage-v8": "^3.0.0",
    "jszip": "^3.10.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.8"
  },
  "packageManager": "yarn@4.11.0+sha512.4e54aeace9141df2f0177c266b05ec50dc044638157dae128c471ba65994ac802122d7ab35bcd9e81641228b7dcf24867d28e750e0bcae8a05277d600008ad54"
}
