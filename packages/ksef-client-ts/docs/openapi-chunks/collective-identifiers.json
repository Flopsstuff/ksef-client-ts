  "paths": {
    "/collective-identifiers": {
      "post": {
        "tags": [
          "Identyfikatory zbiorcze"
        ],
        "summary": "Generowanie identyfikatora zbiorczego",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "invoices"
                ],
                "allOf": [
                  {
                    "$ref": "#/components/schemas/GenerateCollectiveIdentifierRequest"
                  }
                ]
              },
              "example": {
                "invoices": [
                  {
                    "ksefNumber": "1111111111-20260612-6310EC800000-DA",
                    "payment": {
                      "amount": 100,
                      "currency": "PLN"
                    }
                  },
                  {
                    "ksefNumber": "1111111111-20260612-62EAFD400000-B3",
                    "payment": {
                      "amount": 45,
                      "currency": "PLN"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "headers": {
              "X-System-Warning": {
                "schema": {
                  "$ref": "#/components/schemas/SystemWarning"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateCollectiveIdentifierResponse"
                },
                "example": {
                  "collectiveIdentifierNumber": "1111111111-IZ202607-65ED02180000-E7"
                }
              }
            }
          },
          "400": {
