      { "type": "text", "label": "sessionRef", "style": "fieldLabel" },
      { "type": "text", "path": "NumerReferencyjnySesji" }
    ] },
    { "type": "spacer", "height": 10 },
    { "type": "text", "label": "documents", "style": "fieldLabel" },
    {
      "type": "lines",
      "from": "Dokument",
      "columns": [
        { "label": "ksefDocNumber", "path": "NumerKSeFDokumentu" },
        { "label": "invoiceNumber", "path": "NumerFaktury" },
        { "label": "issueDate", "path": "DataWystawieniaFaktury", "format": "date" },
        { "label": "receiptDate", "path": "DataNadaniaNumeruKSeF", "format": "date" },
        { "label": "documentHash", "path": "SkrotDokumentu" }
      ]
    }
  ]
}
